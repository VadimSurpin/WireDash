<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <service android:name="pro.surpin.wiredash.car.CarHostProbeService"
            android:process=":auto_probe" android:exported="true"
            android:permission="android.permission.DUMP" android:foregroundServiceType="connectedDevice" />
        <!-- Debug only: drive the shortcut engine from adb (ShortcutDebugReceiver.kt). -->
        <receiver android:name="pro.surpin.wiredash.ShortcutDebugReceiver" android:exported="true" />
    </application>
</manifest>
